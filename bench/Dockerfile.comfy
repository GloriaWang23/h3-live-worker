# h3-live 精简测速镜像（只给测速 pod 用）：serverless 镜像（4.5 GB，ComfyUI 环境逐字节一致）+ SSH + 多卡插件
#   + Comfy-H3-MultiStream（线程分卡的序列并行，支持稀疏注意力；固定提交）+ venv-comfy 补 pip（Spark-H3 等插件安装要用）
# 原 :bench 镜像 19 GB（含 15 GB 的 SGLang），远端机房拉镜像很慢；ComfyUI 测试用这个。
FROM ghcr.io/gloriawang23/h3-live-worker:sha-6a781e2
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server rsync tmux \
    && rm -rf /var/lib/apt/lists/* && mkdir -p /run/sshd
RUN VIRTUAL_ENV=/opt/venv-comfy uv pip install -q pip && /opt/venv-comfy/bin/python -m pip --version
COPY bench/plugins.lock.json bench/prepare_plugins.py /opt/bench/
RUN /opt/venv-comfy/bin/python /opt/bench/prepare_plugins.py
# ComfyUI PR #17157（10/18 合入上游 ce42de5）：识别自带 PDD 输出头的模型（FastH3-OmniRef 8 步）。只改 minimax 模型与识别两处共 15 行，原样补到 v0.39
COPY bench/comfyui_pr17157_pdd.patch /opt/bench/
RUN cd /opt/ComfyUI && (git apply /opt/bench/comfyui_pr17157_pdd.patch || patch -p1 < /opt/bench/comfyui_pr17157_pdd.patch) \
    && grep -q "pdd_steps=pdd_steps" comfy/ldm/minimax/model.py && grep -q '"pdd_steps", 1' comfy/model_detection.py
RUN cd /opt/ComfyUI && timeout 600 /opt/venv-comfy/bin/python main.py --quick-test-for-ci --cpu 2>&1 | tee /tmp/ci.log \
    && ! grep -qE "IMPORT FAILED|Cannot import .*custom_nodes" /tmp/ci.log
COPY bench/start.sh /opt/bench/start.sh
CMD ["bash", "/opt/bench/start.sh"]
